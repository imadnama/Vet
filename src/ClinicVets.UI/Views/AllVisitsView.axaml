<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicVets.UI.ViewModels"
             x:Class="ClinicVets.UI.Views.AllVisitsView"
             x:DataType="vm:AllVisitsViewModel">

  <Grid RowDefinitions="Auto,*" Margin="36,32,36,32">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="All Clinic Visits" Classes="pageTitle" />
          <TextBlock Text="{Binding StatusMsg}" Classes="pageSubtitle" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                Classes="secondary" Padding="16,8" VerticalAlignment="Center">
          ↺ Refresh
        </Button>
      </Grid>
    </StackPanel>

    <!-- Table + detail -->
    <Grid Grid.Row="1" ColumnDefinitions="*,16,340">

      <!-- DataGrid of visits -->
      <Border Grid.Column="0" Classes="card" Padding="0">
        <DataGrid ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  RowBackground="Transparent"
                  BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date"
                                Binding="{Binding Visit.VisitDateTime, StringFormat='dd/MM/yyyy HH:mm'}"
                                Width="140" />
            <DataGridTextColumn Header="Animal"
                                Binding="{Binding AnimalName}"
                                Width="140" />
            <DataGridTextColumn Header="Veterinarian"
                                Binding="{Binding VetName}"
                                Width="150" />
            <DataGridTextColumn Header="Reason"
                                Binding="{Binding Visit.Reason}"
                                Width="*" />
            <DataGridTextColumn Header="Cost ₪"
                                Binding="{Binding Visit.TotalCost, StringFormat=F2}"
                                Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Detail panel -->
      <Border Grid.Column="2" Classes="card"
              IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding DetailText}"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12" LineHeight="20"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />
      </Border>
    </Grid>

  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24,20" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="DataGridRow:nth-child(even)">
      <Setter Property="Background" Value="#0A0D12" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>
</UserControl>
