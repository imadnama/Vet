<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicVets.UI.ViewModels"
             xmlns:m="using:ClinicVets.Core.Models"
             x:Class="ClinicVets.UI.Views.MedicineInventoryView"
             x:DataType="vm:MedicineInventoryViewModel">

  <Grid RowDefinitions="Auto,*" Margin="36,32,36,32">
    <StackPanel Grid.Row="0" Spacing="20" Margin="0,0,0,20">

      <StackPanel Spacing="4">
        <TextBlock Text="Medicine Inventory" Classes="pageTitle" />
        <TextBlock Text="Add or remove medicines from stock." Classes="pageSubtitle" />
      </StackPanel>

      <!-- Add form card -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Add New Medicine" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" />

          <Grid ColumnDefinitions="*,12,140,12,100">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Name" Classes="fieldLabel" />
              <TextBox Text="{Binding Name}" PlaceholderText="Medicine name" Classes="field" />
              <TextBlock Text="{Binding ErrName}" Classes="errLabel"
                         IsVisible="{Binding ErrName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Price (₪)" Classes="fieldLabel" />
              <NumericUpDown Value="{Binding Price}"
                             Minimum="0.01" Maximum="99999"
                             Increment="0.5" FormatString="F2"
                             Background="#0D1117"
                             BorderBrush="{StaticResource BorderBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding ErrPrice}" Classes="errLabel"
                         IsVisible="{Binding ErrPrice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Spacing="4">
              <TextBlock Text="Qty" Classes="fieldLabel" />
              <NumericUpDown Value="{Binding Quantity}"
                             Minimum="0" Maximum="99999"
                             Increment="1" FormatString="0"
                             Background="#0D1117"
                             BorderBrush="{StaticResource BorderBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding ErrQty}" Classes="errLabel"
                         IsVisible="{Binding ErrQty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding AddCommand}" Classes="primary" Padding="20,8">Add Medicine</Button>
            <Button Command="{Binding DeleteCommand}" Classes="danger" Padding="20,8">Delete Selected</Button>
          </StackPanel>

          <TextBlock Text="{Binding LowStockMsg}"
                     Foreground="{StaticResource WarningBrush}" FontSize="12"
                     IsVisible="{Binding LowStockMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="{Binding ErrorMsg}" Classes="errLabel"
                     IsVisible="{Binding ErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding SuccessMsg}"
                     Foreground="{StaticResource SuccessBrush}" FontSize="12"
                     IsVisible="{Binding SuccessMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Table -->
    <Border Grid.Row="1" Classes="card" Padding="0">
      <DataGrid ItemsSource="{Binding Medicines}"
                SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                Background="Transparent"
                RowBackground="Transparent"
                BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="*" />
          <DataGridTextColumn Header="Price ₪"  Binding="{Binding Price, StringFormat=F2}"    Width="100" />
          <DataGridTextColumn Header="Qty"      Binding="{Binding Quantity}" Width="80" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24,20" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.errLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#0D1117" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#2D1B1B" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="DataGridRow:nth-child(even)">
      <Setter Property="Background" Value="#0A0D12" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>
</UserControl>
