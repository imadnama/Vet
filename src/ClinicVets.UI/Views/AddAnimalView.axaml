<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClinicVets.UI.ViewModels"
             x:Class="ClinicVets.UI.Views.AddAnimalView"
             x:DataType="vm:AddAnimalViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid HorizontalAlignment="Center" Width="500" Margin="0,32,0,32">
      <StackPanel Spacing="0">

        <StackPanel Margin="0,0,0,24" Spacing="4">
          <TextBlock Text="Add Animal" Classes="pageTitle" />
          <TextBlock Text="Register a new patient and assign it to an owner." Classes="pageSubtitle" />
        </StackPanel>

        <Border Classes="card">
          <StackPanel Spacing="14">

            <!-- Name -->
            <StackPanel Spacing="4">
              <TextBlock Text="Animal Name" Classes="fieldLabel" />
              <TextBox Text="{Binding Name}" Watermark="e.g. Max" Classes="field" />
              <TextBlock Text="{Binding ErrName}" Classes="errLabel"
                         IsVisible="{Binding ErrName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Type + Weight row -->
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Type" Classes="fieldLabel" />
                <ComboBox ItemsSource="{Binding AnimalTypes}"
                          SelectedItem="{Binding SelectedType}"
                          HorizontalAlignment="Stretch"
                          Background="#0D1117"
                          BorderBrush="{StaticResource BorderBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Weight (kg)" Classes="fieldLabel" />
                <NumericUpDown Value="{Binding Weight}"
                               Minimum="0.1" Maximum="999"
                               Increment="0.1" FormatString="F1"
                               Background="#0D1117"
                               BorderBrush="{StaticResource BorderBrush}"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ErrWeight}" Classes="errLabel"
                           IsVisible="{Binding ErrWeight, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>

            <!-- Birth Date -->
            <StackPanel Spacing="4">
              <TextBlock Text="Date of Birth" Classes="fieldLabel" />
              <DatePicker SelectedDate="{Binding BirthDate}"
                          HorizontalAlignment="Stretch"
                          Background="#0D1117"
                          BorderBrush="{StaticResource BorderBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding ErrBirth}" Classes="errLabel"
                         IsVisible="{Binding ErrBirth, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Owner -->
            <StackPanel Spacing="4">
              <TextBlock Text="Owner" Classes="fieldLabel" />
              <ComboBox ItemsSource="{Binding Owners}"
                        SelectedItem="{Binding SelectedOwner}"
                        HorizontalAlignment="Stretch"
                        Background="#0D1117"
                        BorderBrush="{StaticResource BorderBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FullName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding ErrOwner}" Classes="errLabel"
                         IsVisible="{Binding ErrOwner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Last Vaccination (optional) -->
            <StackPanel Spacing="4">
              <TextBlock Text="Last Vaccination (optional)" Classes="fieldLabel" />
              <DatePicker SelectedDate="{Binding LastVaccination}"
                          HorizontalAlignment="Stretch"
                          Background="#0D1117"
                          BorderBrush="{StaticResource BorderBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMsg}" Classes="errLabel"
                       IsVisible="{Binding ErrorMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding SuccessMsg}"
                       Foreground="{StaticResource SuccessBrush}" FontSize="12"
                       IsVisible="{Binding SuccessMsg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
              <Button Grid.Column="0" Command="{Binding BackCommand}" Classes="secondary">← Back</Button>
              <Button Grid.Column="2" Command="{Binding SaveCommand}" Classes="primary">Save Animal</Button>
            </Grid>

          </StackPanel>
        </Border>

      </StackPanel>
    </Grid>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="28,24" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.errLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#0D1117" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>
</UserControl>
